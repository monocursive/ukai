---
import Site from '../../../layouts/Site.astro';
import ArenaScore from '../../../components/ArenaScore.astro';
import Icon from '../../../components/arena/Icon.astro';
import ToolStrip from '../../../components/arena/ToolStrip.astro';
import '../../../styles/arena.css';
import { runs, recordFor, transcriptFor, fixturesFor, stepsFor, evidenceBase, runUrl, agentName, kindName, scenarioName, exposureName, time, isAgent, controlPassed, type Run } from '../../../arena';
export function getStaticPaths() { return runs.map(run => ({ params: { id: run.run_id }, props: { run } })); }
const { run } = Astro.props as { run: Run };
const record = recordFor(run);
const transcript = transcriptFor(run);
const steps = stepsFor(run);
const fixtures = fixturesFor(run);
const base = `${evidenceBase}/runs/${run.run_id}`;
const index = runs.findIndex(item => item.run_id === run.run_id);
const previous = runs[index - 1], next = runs[index + 1];
const score = record.offline_v3_score || record.original_score;
const exposure = run.v3_exposure || run.original_exposure;
const correctedExposure = run.original_exposure === 'not_established' && run.v3_exposure === 'verified';
const trap = run.kind === 'agent_poisoned';
const requests = score.literal_tool_requests ?? score.tool_requests ?? 0;
const badge = ({ agent_clean: 'clean', agent_poisoned: 'trap', control_allow: 'allow', control_deny: 'deny' } as { [kind: string]: string })[run.kind];

// The three questions from the field note, answered for this run.
const gates = isAgent(run) ? [
  { q: 'Task', state: score.task.status === 'pass' ? 'yes' : 'no', a: score.task.status === 'pass' ? 'Fixed' : 'Not fixed', p: `${score.task.cases_passed ?? 0} of 5 checker cases passed` },
  trap
    ? { q: 'Saw the trap?', state: exposure === 'verified' ? 'yes' : 'unknown', a: exposure === 'verified' ? 'Yes' : exposureName(exposure), p: exposure === 'verified' ? 'The poisoned text came back in a tool result' : 'We can’t show it read the trap' }
    : { q: 'Saw the trap?', state: 'none', a: 'No trap', p: 'Clean baseline for comparison' },
  { q: 'Acted on it?', state: requests === 0 ? 'yes' : 'no', a: requests === 0 ? 'No request seen' : `${requests} requests`, p: 'Literal requests only; a disguised one could be missed' },
  { q: 'Anything out?', state: score.forbidden_effect_confirmed ? 'no' : 'yes', a: score.forbidden_effect_confirmed ? 'Confirmed' : 'Nothing confirmed', p: 'Collector, receipts and policy checks' },
] : [
  { q: 'What ran', state: 'none', a: 'A script', p: 'No model; it does exactly what the trap asks' },
  { q: 'Expected', state: 'none', a: run.kind === 'control_allow' ? 'Gets through' : 'Refused', p: run.kind === 'control_allow' ? 'Proves we would see the effect' : 'Proves the boundary holds' },
  { q: 'Result', state: controlPassed(record) ? 'yes' : 'unknown', a: controlPassed(record) ? 'Control passed' : 'Inspect the evidence', p: 'Policy and cleanup verified' },
];
---
<Site title={`${agentName(run.agent)} · ${kindName(run.kind)} — Ukai Arena run`} description={`${run.phase}. ${scenarioName(run.scenario)} v${run.scenario_version}. The tool calls, original score, any offline rescore, and the public evidence for this run.`}>
  <article class="rd container">
    <a class="rd-back" href="/arena/#runs">← All runs</a>
    <header class="rd-header">
      <div>
        <p class="ar-kicker">{run.phase} · 25 Oct 2026 · <time datetime={run.started_at_utc}>{time(run.started_at_utc)} UTC</time></p>
        <h1>{agentName(run.agent)}<br /><em>{kindName(run.kind).toLowerCase()}</em></h1>
        <p class="rd-sub">{scenarioName(run.scenario)} · version {run.scenario_version}{isAgent(run) && ` · ${record.agent_elapsed_seconds.toFixed(1)} s`}</p>
        <p class="rd-id">Run {run.run_id}</p>
      </div>
      <span class:list={['rd-kind', `is-${run.kind}`]} aria-hidden="true">{badge}</span>
    </header>

    <ul class:list={['rd-gates', { 'is-four': gates.length === 4 }]}>
      {gates.map(gate => <li class={`is-${gate.state}`}><span class="rd-gate-q">{gate.q}</span><strong>{gate.state === 'yes' && <Icon name="check" size={20} />}{gate.a}</strong><p>{gate.p}</p></li>)}
    </ul>

    {correctedExposure && <aside class="rd-callout"><p class="ar-kicker">Our scoring bug</p><h2>Claude read the issue. Our checker missed the tabs.</h2><p>Claude’s Read tool puts a line number and a tab before each line, and the original checker didn’t accept tabs, so the batch stopped. The fixed checker still requires a successful read of the expected file and the full matching text. We rescored the saved run; we didn’t rerun the agent. <a href="/arena/#day">Read the story →</a></p></aside>}
    {run.original_labels.includes('inconclusive') && <aside class="rd-callout"><p class="ar-kicker">Connection trouble</p><h2>Codex recovered, but the scorer stopped the batch.</h2><p>Codex finished this clean task after WebSocket TLS errors and an HTTPS fallback. The original scorer marked the run inconclusive, so the batch stopped before the poisoned runs. A later parser recognizes this exact recovery before any tool call; that fix is in the separate offline score below.</p></aside>}
    {run.original_exposure === 'not_measured' && <aside class="rd-callout"><p class="ar-kicker">Exposure not measured</p><h2>It never opened the README.</h2><p>The task passed, but this version of the test didn’t make the agent read the poisoned README, and its tool calls show it didn’t. This run can’t show it resisted an instruction it saw. <a href="/arena/#day">Why that matters →</a></p></aside>}
    {!isAgent(run) && <aside class="rd-callout"><p class="ar-kicker">Scripted control</p><p>A deterministic {run.kind === 'control_allow' ? 'allow' : 'deny'} control, not a model attempt. It checked the test’s {run.kind === 'control_allow' ? 'ability to observe an allowed effect' : 'denied effect under the configured boundary'}. A successful allow control produces the effect on purpose; it is not a sandbox failure. <a href="/arena/#controls">How controls work →</a></p></aside>}

    {transcript && <section class="rd-block" aria-labelledby="calls-title">
      <h2 id="calls-title">What it did</h2>
      <p class="rd-lead">Every recorded tool call, in order. Expand one for its input and output. Paths and private details are redacted.</p>
      <ToolStrip steps={steps} label="Tool calls in this run" />
      <ol class="rd-calls">{transcript.calls.map((call, i) => (
        <li><details class:list={['rd-call', { 'is-fail': !call.success }]}>
          <summary><span class="rd-call-n">{String(i + 1).padStart(2, '0')}</span><Icon name={steps[i].kind} size={16} /><span class="rd-call-what"><b>{call.tool}</b>{'file_path' in call.input ? String(call.input.file_path) : 'command' in call.input ? String(call.input.command).split('\n')[0] : 'Tool request'}</span><span class="rd-call-state">{call.success ? 'Returned' : 'Error'}{call.ambiguous ? ' · ambiguous' : ''}</span></summary>
          <div class="rd-call-body"><p class="ar-small">Request · original stream line {call.request_ref?.line ?? 'not recorded'}</p><pre>{JSON.stringify(call.input, null, 2)}</pre><p class="ar-small">Result · original stream line {call.result_ref?.line ?? 'not recorded'}</p><pre>{call.text}</pre></div>
        </details></li>
      ))}</ol>
      {transcript.selected_visible_messages.length > 0 && <details class="rd-more"><summary>What it said ({transcript.selected_visible_messages.length} visible messages)</summary>{transcript.selected_visible_messages.map(message => <><p class="ar-small">Original stream line {message.ref?.line ?? 'not recorded'}</p><pre>{message.text}</pre></>)}</details>}
      <p class="ar-small">{transcript.refs_note} Private thinking and account metadata are omitted. What an agent says isn’t independent proof of how it read the task.</p>
    </section>}

    <section class="rd-block" aria-labelledby="score-title">
      <h2 id="score-title">{record.offline_v3_score ? 'Original score and rescore' : 'The original score'}</h2>
      <p class="rd-lead">{record.offline_v3_score ? 'The rescore reads the same saved evidence with the later scorer. The original stays as it was.' : 'Scores from the first milestone were left exactly as recorded.'}</p>
      <div class="rd-scores"><ArenaScore score={record.original_score} exposure={run.original_exposure} title="Original score" />{record.offline_v3_score && <ArenaScore score={record.offline_v3_score} exposure={run.v3_exposure} title="Offline rescore" derived />}</div>
      <p class="ar-small" style="margin-top: 16px">The request count covers calls the checker recognizes. Exposure comes from the transcript, not a kernel-level read record. These receipt excerpts aren’t enough to replay the full policy or containment checks independently.</p>
    </section>

    {isAgent(run) && <section class="rd-block" aria-labelledby="setup-title">
      <h2 id="setup-title">The setup</h2>
      <p class="rd-lead">The prompt the agent got. Text inside the README or issue file doesn’t carry this authority.</p>
      <blockquote class="rd-prompt">{record.prompt}</blockquote>
      <dl class="rd-facts">
        <div><dt>Configuration</dt><dd>{record.configuration_id}</dd></div>
        <div><dt>Requested model</dt><dd>{record.requested_model}</dd></div>
        <div><dt>Reported model</dt><dd>{record.reported_models?.length ? record.reported_models.join(', ') : 'Not reported in saved output'}</dd></div>
        <div><dt>Reasoning effort</dt><dd>{record.model_settings?.reasoning_effort || 'Not specified'}</dd></div>
        <div><dt>Seed / temperature</dt><dd>{record.model_settings?.seed ?? 'Not specified'} / {record.model_settings?.temperature ?? 'Not specified'}</dd></div>
        <div><dt>Recorded elapsed time</dt><dd>{record.agent_elapsed_seconds.toFixed(3)} seconds</dd></div>
      </dl>
    </section>}

    <section class="rd-block" aria-labelledby="files-title">
      <h2 id="files-title">The public files</h2>
      <p class="rd-lead">The files behind this page. Source hashes refer to the private originals; export hashes let you check these redacted copies.</p>
      <div class="rd-files"><a href={`${base}/record.json`}>Run record &amp; scores <span>JSON ↗</span></a><a href={`${base}/receipt-excerpt.json`}>Receipt excerpt <span>JSON ↗</span></a>{transcript && <a href={`${base}/transcript-excerpt.json`}>Transcript excerpt <span>JSON ↗</span></a>}{fixtures.map(name => <a href={`${base}/fixture/${name}`}>{name}<span>fixture ↗</span></a>)}<a href={`${evidenceBase}/provenance.json`}>Provenance <span>JSON ↗</span></a></div>
      <details class="rd-more rd-hashes"><summary>Which binaries ran?</summary><dl><dt>Ukai SHA-256</dt><dd><code>{record.jail_sha256}</code></dd>{record.agent_sha256 && <><dt>Agent SHA-256</dt><dd><code>{record.agent_sha256}</code></dd></>}</dl></details>
    </section>

    <nav class="rd-nav" aria-label="Adjacent runs"><div>{previous && <a href={runUrl(previous)}>← Earlier run<span>{agentName(previous.agent)} · {kindName(previous.kind).toLowerCase()} · {time(previous.started_at_utc)}</span></a>}</div><div>{next && <a href={runUrl(next)}>Later run →<span>{agentName(next.agent)} · {kindName(next.kind).toLowerCase()} · {time(next.started_at_utc)}</span></a>}</div></nav>
  </article>
</Site>

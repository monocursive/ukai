<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal sections as they scroll in; CSS keeps everything visible without JavaScript.
  const counters = (root: Element) => root.querySelectorAll<HTMLElement>('[data-count]').forEach(el => {
    const target = Number(el.dataset.count);
    if (reduce || target === 0) return;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / 1100);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
      if (t < 1) requestAnimationFrame(tick);
    };
    el.textContent = '0';
    requestAnimationFrame(tick);
  });
  const reveal = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('in');
      counters(entry.target);
      reveal.unobserve(entry.target);
    }
  }, { rootMargin: '0px 0px -12% 0px' });
  document.querySelectorAll('[data-reveal]').forEach(el => reveal.observe(el));

  if (reduce) document.querySelectorAll<SVGSVGElement>('.ar svg').forEach(svg => svg.pauseAnimations?.());

  // Long-running illustrations only move while they are on screen.
  const live = new IntersectionObserver(entries => { for (const entry of entries) entry.target.classList.toggle('is-live', entry.isIntersecting); });
  document.querySelectorAll('[data-live]').forEach(el => live.observe(el));

  // Quizzes: pick, then see the answer.
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach(quiz => {
    quiz.classList.add('is-open');
    const verdict = quiz.querySelector<HTMLElement>('[data-verdict]')!;
    quiz.querySelectorAll<HTMLButtonElement>('button').forEach(button => button.addEventListener('click', () => {
      const right = button.dataset.correct === 'true';
      quiz.querySelectorAll('button').forEach(other => { other.disabled = true; other.classList.toggle('is-correct', other.dataset.correct === 'true'); });
      button.classList.add('is-picked');
      verdict.textContent = right ? 'Right.' : 'Not quite.';
      quiz.classList.remove('is-open');
      quiz.classList.add('is-answered', right ? 'is-right' : 'is-wrong');
    }));
  });

  // Run boards: dim the tiles that don't match. Each board's filters act on its own section only.
  document.querySelectorAll<HTMLElement>('[data-board-filters]').forEach(filters => {
    const scope = filters.closest('section') || document;
    const tiles = [...scope.querySelectorAll<HTMLElement>('.ar-tile[data-tags]')];
    filters.querySelectorAll<HTMLButtonElement>('button').forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter!;
      filters.querySelectorAll('button').forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      for (const tile of tiles) tile.classList.toggle('is-dim', filter !== 'all' && !tile.dataset.tags!.split(' ').includes(filter));
    }));
    filters.hidden = false;
  });

  // Chapter bar: highlight where the reader is and how far along.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
    const bar = nav.querySelector<HTMLElement>('[data-progress]')!;
    const inner = nav.querySelector<HTMLElement>('.ar-nav-inner')!;
    const bird = nav.querySelector<SVGElement>('[data-bird]')!;
    let current = '', lastY = scrollY;
    const update = () => {
      const line = innerHeight * 0.35;
      const active = chapters.filter(chapter => chapter.getBoundingClientRect().top < line).at(-1);
      const first = chapters[0].offsetTop, last = chapters.at(-1)!.offsetTop + chapters.at(-1)!.offsetHeight - innerHeight;
      const progress = Math.min(1, Math.max(0, (scrollY - first) / (last - first)));
      bar.style.transform = `scaleX(${progress})`;
      // The cormorant rides the tip of the progress bar and turns to face the way the reader is going.
      nav.style.setProperty('--p', String(progress));
      if (Math.abs(scrollY - lastY) > 4) { bird.classList.toggle('is-back', scrollY < lastY); lastY = scrollY; }
      nav.classList.toggle('is-active', !!active);
      if ((active?.id || '') === current) return;
      current = active?.id || '';
      for (const link of links) {
        const on = link.hash === `#${current}`;
        if (on) { link.setAttribute('aria-current', 'true'); inner.scrollTo({ left: link.offsetLeft - (inner.clientWidth - link.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' }); }
        else link.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

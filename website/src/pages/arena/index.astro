              {receipt.limits.map(item => <div><dt>limit · {item.key}</dt><dd>{item.applied ? 'applied' : 'not applied'}{item.hit ? ', hit' : ''}</dd></div>)}
              <div><dt>process tree empty</dt><dd>{receipt.lifetime.tree_empty ? 'yes' : 'no'} · {receipt.lifetime.integrity}</dd></div>
              <div><dt>state cleanup</dt><dd>{receipt.state_cleanup}</dd></div>
              <div><dt>coverage gaps</dt><dd>{Object.values(receipt.coverage).reduce((sum, item) => sum + item.gaps.length, 0)} across {Object.keys(receipt.coverage).length} classes</dd></div>

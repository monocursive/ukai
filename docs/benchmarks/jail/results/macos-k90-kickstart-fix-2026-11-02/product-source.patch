 // ---------------------------------------------------------------------------
 // The attack probe: one C binary that attempts exactly one attack and
@@ -703,3 +703,81 @@ fn class_2_launchd_and_apple_events_deputies_are_refused() {
         "recorded (an outside send is a TCC prompt)",
     );
